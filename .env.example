# ---- LLM provider: groq | ollama | openai | anthropic | none (rule-based offline mode)
LLM_PROVIDER=groq
# Leave empty for the provider default (Groq: openai/gpt-oss-120b).
LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- OCR for scanned / photographed B/Ls and invoices (images and image-only PDFs)
# auto (vision model if VISION_MODEL is set, else Tesseract if installed) | tesseract | vision | none
OCR_ENGINE=auto
# A vision-capable chat model on Groq (uses GROQ_API_KEY; OpenAI when LLM_PROVIDER=openai),
# e.g. meta-llama/llama-4-scout-17b-16e-instruct - check Groq's current model list first,
# vision models are renamed and retired often. Empty = Tesseract only.
VISION_MODEL=

# ---- Storage
# Leave DATABASE_URL empty to use the in-memory vector store / CSV volume data.
DATABASE_URL=postgresql://admin:password123@localhost:5432/supply_chain
# Leave REDIS_URL empty to use the in-process semantic cache.
REDIS_URL=redis://localhost:6379/0

# ---- Retrieval
# sentence-transformers (real embeddings) | hashing (fast, offline, deterministic)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# flashrank | lexical
RERANKER_BACKEND=flashrank

# ---- Semantic cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# ---- Observability (free LangSmith developer tier)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supply-chain-ai-copilot
MLFLOW_TRACKING_URI=file:./mlruns

# ---- Real-world data (optional)
# Free OpenRouteService key for truck road routing: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Live rain forecast for delay risk from Open-Meteo (free, no key). Set false to stay offline.
WEATHER_ENABLED=true
